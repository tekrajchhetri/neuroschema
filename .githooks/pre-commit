#!/bin/sh
# Generated evaluation data is written only by the "Evaluate catalog" GitHub Action.
# Committing it locally is what causes merge conflicts, so refuse it here.
# (Merges that bring in the Action's commits are allowed.)
[ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ] && exit 0
[ "$NEUROSCHEMA_ALLOW_DATA" = "1" ] && exit 0
bad=$(git diff --cached --name-only -- data/evaluation.json data/runs data/quality)
if [ -n "$bad" ]; then
  echo "✗ These files are generated by the Evaluate catalog GitHub Action and must not be committed locally:" >&2
  echo "$bad" | sed 's/^/    /' >&2
  echo "  Unstage them:  git restore --staged data/evaluation.json data/runs data/quality && git checkout -- data/" >&2
  echo "  Local evaluation runs write to .local/data/ (ignored) and are previewed by the build." >&2
  exit 1
fi
