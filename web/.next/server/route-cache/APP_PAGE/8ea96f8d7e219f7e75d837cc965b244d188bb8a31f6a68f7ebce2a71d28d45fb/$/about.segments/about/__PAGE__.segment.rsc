f:["$","section",null,{"className":"wrap section prose","children":[["$","h2",null,{"children":"What this is"}],["$","p",null,{"children":"Neuroscience data is described with dozens of ontologies, controlled vocabularies, metadata schemas and data standards, maintained by different communities and registries. NeuroSchema brings them into one catalog, organised by domain, so you can see what exists, which version is current, how FAIR and well maintained it is, and who already uses it."}],["$","p",null,{"children":"Each resource stays with its maintainers. This catalog links to the canonical homepage, repository, download PURL and ontology browsers; it does not copy or re-license their files."}],["$","h2",null,{"id":"contribute","children":"Contributing"}],["$","p",null,{"children":["Everything is tracked in Git. Use the ",["$","$L3",null,{"href":"/submit/","children":"submission form"}],", which opens a pre-filled GitHub issue that a bot converts into a pull request, or edit ",["$","code",null,{"children":"data/catalog.json"}]," and open a pull request yourself on ",["$","a",null,{"href":"https://github.com/tekrajchhetri/neuroschema","rel":"noopener","children":"GitHub"}],". Every pull request is validated, link-checked, de-duplicated and FAIR-evaluated in CI before a maintainer reviews and merges it."]}],["$","h2",null,{"children":"Use the data"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","a",null,{"href":"http://127.0.0.1:62760/api/entries","children":["$","code",null,{"children":"/api/entries"}]}],": search and filter every entry, with its latest score and evaluated version."]}],["$","li",null,{"children":[["$","code",null,{"children":"/api/entries/<id>"}],": a single entry with its full evaluation, history across runs and what changed."]}],["$","li",null,{"children":[["$","a",null,{"href":"http://127.0.0.1:62760/api/runs","children":["$","code",null,{"children":"/api/runs"}]}],": every archived evaluation run."]}],["$","li",null,{"children":[["$","a",null,{"href":"http://127.0.0.1:62760/docs","children":["$","code",null,{"children":"/docs"}]}],": interactive API documentation (OpenAPI)."]}],["$","li",null,{"children":["An MCP server for AI agents: see ",["$","$L3",null,{"href":"/api-docs/","children":"API & MCP"}],"."]}],["$","li",null,{"children":[["$","a",null,{"href":"https://github.com/tekrajchhetri/neuroschema/blob/main/data/catalog.schema.json","children":["$","code",null,{"children":"catalog.schema.json"}]}],": JSON Schema for catalog entries."]}]]}],["$","p",null,{"children":"Entry pages embed schema.org JSON-LD (Dataset) so search engines, including Google Dataset Search, can index the catalog."}]]}]
