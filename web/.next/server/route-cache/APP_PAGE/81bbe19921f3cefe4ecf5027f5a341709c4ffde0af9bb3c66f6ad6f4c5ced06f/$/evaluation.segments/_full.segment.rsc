ull,{"children":["$","b",null,{"className":"sym","children":"A"}]}],["$","td",null,{"children":["Accessible",[" ",["$","span",null,{"className":"fair-tag","children":"FAIR"}]],["$","p",null,{"className":"small muted","children":"A1 — the machine-readable artefact (download PURL or repository) is retrievable over HTTP(S) (6) and the homepage resolves (3). A2 — metadata stays available even if the resource disappears, because it has a persistent record in a registry: OLS, TIB, BioPortal, OBO Foundry, Bioregistry, FAIRsharing or LOV (3). Hosts that refuse automated checks count as reachable."}]]}],["$","td",null,{"className":"num","children":12}],["$","td",null,{"children":["$","code",null,{"children":"3·[homepage reachable] + 6·[artefact retrievable over HTTP(S)] + 3·[metadata persists in a registry]"}]}]]}],["$","tr","interoperable",{"children":[["$","td",null,{"children":["$","b",null,{"className":"sym","children":"I"}]}],["$","td",null,{"children":["Interoperable",[" ",["$","span",null,{"className":"fair-tag","children":"FAIR"}]],["$","p",null,{"className":"small muted","children":"I1 — a formal, broadly applicable language (OWL, OBO, Turtle, RDF, JSON-LD, LinkML, JSON Schema, SHACL, YAML schema, XSD) (5). I2 — a semantic-web representation (OWL, OBO, Turtle, RDF, JSON-LD, SHACL) whose terms are resolvable IRIs (3). I3 — qualified references to other vocabularies: ontologies it imports (OLS, Bioregistry, and owl:imports in the file itself) or whose terms it uses (at least 3 distinct terms in the file): ≥ 3 → 4, 1–2 → 2."}]]}],["$","td",null,{"className":"num","children":12}],["$","td",null,{"children":["$","code",null,{"children":"5·[formal format] + 3·[semantic-web IRIs] + i(imported vocabularies)"}]}]]}],["$","tr","reusable",{"children":[["$","td",null,{"children":["$","b",null,{"className":"sym","children":"R"}]}],["$","td",null,{"children":["Reusable",[" ",["$","span",null,{"className":"fair-tag","children":"FAIR"}]],["$","p",null,{"className":"small muted","children":"R1.1 — a clear license: a recognised open license scores 5, any other stated license 2. R1.2 — provenance of releases: a version IRI or version info inside the artefact scores 4; a release tag or registry version only, 2. R1.3 — meets community standards: the better of the share of OBO Foundry principle checks passed on the OBO Dashboard (× 3) and a listing in FAIRsharing, a standards registry that reviews what it includes (2). LOV is counted under F4 and A2 only, so one listing isn't counted three times."}]]}],"$L18","$L19"]}],"$L1a","$L1b","$L1c"],"$L1d"]}]]}]}],null,"$L1e"]}],"$L1f"]
