{
  "name": "neuroschema.org",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Static catalog of neuroscience ontologies and schemas, with automated evaluation.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && PORT=3200 node scripts/serve.mjs",
    "serve": "PORT=3200 node scripts/serve.mjs",
    "validate": "node scripts/validate.mjs",
    "validate:online": "node scripts/validate.mjs --online",
    "quality": "node scripts/quality.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "rescore": "node scripts/rescore.mjs",
    "images": "docker build -q -t neuroschema/oops docker/oops && docker build -q -t neuroschema/robot docker/robot",
    "refresh": "scripts/refresh.sh"
  }
}
